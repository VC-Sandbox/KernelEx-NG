; Extra kexnt.dll exports that are NOT named after their kex_ implementation.
; Every stdcall kex_<Name>@N in the objects is exported as <Name> automatically
; (see the build/kexnt.def rule in the Makefile); list only aliases here.
    ZwQuerySystemInformation=kex_NtQuerySystemInformation@16
    ZwSetInformationThread=kex_NtSetInformationThread@16
    ZwCreateThreadEx=kex_NtCreateThreadEx@44
    RtlInitializeSRWLock=kex_InitializeSRWLock@4
    RtlAcquireSRWLockExclusive=kex_AcquireSRWLockExclusive@4
    RtlAcquireSRWLockShared=kex_AcquireSRWLockShared@4
    RtlReleaseSRWLockExclusive=kex_ReleaseSRWLockExclusive@4
    RtlReleaseSRWLockShared=kex_ReleaseSRWLockShared@4
    RtlTryAcquireSRWLockExclusive=kex_TryAcquireSRWLockExclusive@4
    RtlTryAcquireSRWLockShared=kex_TryAcquireSRWLockShared@4
    RtlInitializeConditionVariable=kex_InitializeConditionVariable@4
    RtlWakeConditionVariable=kex_WakeConditionVariable@4
    RtlWakeAllConditionVariable=kex_WakeAllConditionVariable@4
    RtlWakeAddressSingle=kex_WakeByAddressSingle@4
    RtlWakeAddressAll=kex_WakeByAddressAll@4
    RtlRunOnceInitialize=kex_InitOnceInitialize@4
    RtlInitializeSListHead=kex_InitializeSListHead@4
    RtlInterlockedPushEntrySList=kex_InterlockedPushEntrySList@8
    RtlInterlockedPopEntrySList=kex_InterlockedPopEntrySList@4
    RtlInterlockedFlushSList=kex_InterlockedFlushSList@4
    RtlQueryDepthSList=kex_QueryDepthSList@4
    RtlInterlockedPushListSListEx=kex_InterlockedPushListSListEx@16
    ZwQueryInformationProcess=kex_NtQueryInformationProcess@20
    ZwQueryObject=kex_NtQueryObject@20
    ZwWriteFile=kex_NtWriteFile@36
    ZwReadFile=kex_NtReadFile@36
    ZwQueryVolumeInformationFile=kex_NtQueryVolumeInformationFile@20
    InetNtopA=kex_inet_ntop@16
    InetPtonA=kex_inet_pton@12
    ZwOpenKeyEx=kex_NtOpenKeyEx@16
    ZwOpenKey=kex_NtOpenKey@12
    ZwCreateKey=kex_NtCreateKey@28
    ZwDeleteKey=kex_NtDeleteKey@4
    ZwFlushKey=kex_NtFlushKey@4
    ZwQueryValueKey=kex_NtQueryValueKey@24
    ZwSetValueKey=kex_NtSetValueKey@24
    ZwDeleteValueKey=kex_NtDeleteValueKey@8
    ZwClose=kex_NtClose@4
    ZwQueryInformationThread=kex_NtQueryInformationThread@20
    ZwOpenProcessToken=kex_NtOpenProcessToken@12
    ZwOpenProcessTokenEx=kex_NtOpenProcessTokenEx@16
    ZwOpenThreadToken=kex_NtOpenThreadToken@16
    ZwOpenThreadTokenEx=kex_NtOpenThreadTokenEx@20
    ZwQueryInformationToken=kex_NtQueryInformationToken@20
    ZwAdjustPrivilegesToken=kex_NtAdjustPrivilegesToken@24
    ZwSetInformationToken=kex_NtSetInformationToken@16
    ZwDuplicateToken=kex_NtDuplicateToken@24
    ZwQuerySection=kex_NtQuerySection@20
    ZwShutdownSystem=kex_NtShutdownSystem@4
    ZwAllocateVirtualMemory=kex_NtAllocateVirtualMemory@24
    ZwMapViewOfSection=kex_NtMapViewOfSection@40
    ZwUnmapViewOfSection=kex_NtUnmapViewOfSection@8
    ZwQueryInformationFile=kex_NtQueryInformationFile@20
    ZwQueryVirtualMemory=kex_NtQueryVirtualMemory@24
    ZwReadVirtualMemory=kex_NtReadVirtualMemory@20
    ZwOpenFile=kex_NtOpenFile@24
    _allmul=kex_allmul@16
    ZwDuplicateObject=kex_NtDuplicateObject@28
